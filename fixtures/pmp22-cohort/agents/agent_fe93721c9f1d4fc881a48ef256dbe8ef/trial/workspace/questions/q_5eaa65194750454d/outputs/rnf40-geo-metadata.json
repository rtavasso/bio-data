hael,,Wegner"],"Series_contact_state":["Bavaria"],"Series_contact_zip/postal_code":["91054"],"Series_contributor":["Franziska,,Fröb","Elisabeth,,Sock"],"Series_geo_accession":["GSE146629"],"Series_last_update_date":["Oct 02 2020"],"Series_overall_design":["We generated mRNA profiles of sciatic nerves from 14-day old control mice (ctrl; carrying floxed Rnf40 alleles) and mice with a Schwann cell-specific Rnf40 deletion (cko; carrying Rnf40 alleles in combination with a Dhh::Cre transgene) using the Illumina HiSeq 2500 platform."],"Series_platform_id":["GPL17021"],"Series_platform_organism":["Mus musculus"],"Series_platform_taxid":["10090"],"Series_pubmed_id":["32672815"],"Series_relation":["SubSeries of: GSE146646","BioProject: https://www.ncbi.nlm.nih.gov/bioproject/PRJNA611550","SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRP252062"],"Series_sample_id":["GSM4399927","GSM4399928","GSM4399929","GSM4399930","GSM4399931","GSM4399932"],"Series_sample_organism":["Mus musculus"],"Series_sample_taxid":["10090"],"Series_status":["Public on Jul 13 2020"],"Series_submission_date":["Mar 09 2020"],"Series_summary":["To address the role of monoubiquitination of histone H2B at lysine 120 (H2Bub1), we inactivated the responsible E3 ligase by deleting Rnf40 in developing Schwann cells. Rnf40 becomes important for proper Schwann cell development shortly before and during differentiation. Its absence in Schwann cells leads to a peripheral neuropathy. RNA-Seq studies were performed on sciatic nerves from control mice and mice with a Schwann cell-specific deletion of Rnf40 to analyze changes in gene expression. These revealed substantial changes in the expression of genes associated with myelination, lipid metabolism and cell adhesion."],"Series_supplementary_file":["ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE146nnn/GSE146629/suppl/GSE146629_RAW.tar","ftp://ftp.ncbi.nlm.nih.gov/geo/series/GSE146nnn/GSE146629/suppl/GSE146629_RNF40_SC_cko_vs_ctrl.xlsx"],"Series_title":["Role of Rnf40-dependent histone monoubiquitination in peripheral nervous system myelination [RNA-Seq]"],"Series_type":["Expression profiling by high throughput sequencing"]},"id":"GSE146629","kind":"SERIES"},"id":"study_3a989262046f087a6107edfa","kind":"study","native_id":"GSE146629"}],"source_record":{"reference":"GSE146629"}},"level":0,"limitations":["Metadata enumeration does not mean bytes were acquired or features measured"],"origin":"source_manifest","profile_schema":"1","scientific_applicability":"question_local; not certified by this profile","subject":"bundle_3a989262046f087a6107edfa","summary":"bundle from geo; source metadata, no inference of scientific suitability.","title":"GSE146629"}],"relationships":[{"id":"fae1ab2ffb229ca35e05d7b2b69f217b8de9db6a7eaf2b1fbfe87e298dbb6aae","locator":"^SERIES = GSE146629","object":"study_3a989262046f087a6107edfa","relationship":"describes","snapshot_id":"snap_4d5517ccc20243a1a1c69c4b9367f93f","state":"accepted","subject":"bundle_3a989262046f087a6107edfa"},{"id":"0f5a2cef8de8e7adec84eb505f6c357063e7844d9fbcc8cb0c39ef5d678e22b4","locator":"^SAMPLE = GSM4399927","object":"sample_bcbbe86a77da524ccecff60b","relationship":"contains_sample","snapshot_id":"snap_0ce95661213749a48ac4f056210d2425","state":"accepted","subject":"bundle_3a989262046f087a6107edfa"},{"id":"c40c3b73ebd95f2bab4aeebcebbb4ce1e4fe95a7950ce870efd06712017ae2b2","locator":"^SAMPLE = GSM4399928","object":"sample_8566f15e6919e62af989b64c","relationship":"contains_sample","snapshot_id":"snap_0ce95661213749a48ac4f056210d2425","state":"accepted","subject":"bundle_3a989262046f087a6107edfa"},{"id":"151813bbfb509c774153b51baf89ff7593fcfb8b936f25a40e56bcb81efb74c5","locator":"^SAMPLE = GSM4399929","object":"sample_2d8760acfdd494135146076e","relationship":"contains_sample","snapshot_id":"snap_0ce95661213749a48ac4f056210d2425","state":"accepted","subject":"bundle_3a989262046f087a6107edfa"},{"id":"564994420aaef80bfc263c58597b2738c5f69c15ca6d34c716baaddea1ba98a2","locator":"^SAMPLE = GSM43999